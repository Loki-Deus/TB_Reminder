# Environment variables — never commit this
.env

# Python cache
__pycache__/
*.pyc
*.pyo

# Virtual environment
venv/
.venv/

# OS junk
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Runtime data (persistent, kept in DATA_DIR on the server). Whole
# directory, not individual filenames -- stats.json, requirements/*.json,
# and *.bak.json backups all live here, and enumerating them one at a
# time is exactly how a stray file can slip through and get committed
# (see TW-Counter's .gitignore for the precedent).
data/
